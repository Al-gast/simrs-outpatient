digraph physical_erd {
graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=1.2, splines=spline, fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Physical ERD - Kunjungan dan pemeriksaan\nTabel referensi luar kelompok ditampilkan ringkas | PK: primary key | FK: foreign key | UQ: unik | NN: wajib diisi\nAngka pada garis menunjukkan kardinalitas; buka SVG untuk memperbesar."];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [color="#8393A0", fontcolor="#42566A", fontname="DejaVu Sans", fontsize=9, arrowsize=0.6, dir=both, arrowhead=none, arrowtail=none];
visits [label=<<TABLE BORDER="1" COLOR="#176D72" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#176D72"><FONT COLOR="white"><B>visits</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">patient_id</TD><TD PORT="patient_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">doctor_id</TD><TD PORT="doctor_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">clinic_id</TD><TD PORT="clinic_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">schedule_id</TD><TD PORT="schedule_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">visit_date</TD><TD PORT="visit_date" ALIGN="LEFT">date</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">queue_number</TD><TD PORT="queue_number" ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">registration_fee</TD><TD PORT="registration_fee" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">status</TD><TD PORT="status" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">registered_by</TD><TD PORT="registered_by" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">updated_at</TD><TD PORT="updated_at" ALIGN="LEFT">timestamptz</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ (patient_id, clinic_id, visit_date)</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ (clinic_id, visit_date, queue_number)</TD></TR></TABLE>>];
medical_records [label=<<TABLE BORDER="1" COLOR="#176D72" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#176D72"><FONT COLOR="white"><B>medical_records</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK UQ NN</TD><TD ALIGN="LEFT">visit_id</TD><TD PORT="visit_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">complaint</TD><TD PORT="complaint" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">anamnesis</TD><TD PORT="anamnesis" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">vital_signs</TD><TD PORT="vital_signs" ALIGN="LEFT">jsonb</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">physical_exam</TD><TD PORT="physical_exam" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">primary_diagnosis</TD><TD PORT="primary_diagnosis" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">secondary_diagnoses</TD><TD PORT="secondary_diagnoses" ALIGN="LEFT">jsonb</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">version</TD><TD PORT="version" ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">updated_by</TD><TD PORT="updated_by" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">updated_at</TD><TD PORT="updated_at" ALIGN="LEFT">timestamptz</TD></TR></TABLE>>];
visit_procedures [label=<<TABLE BORDER="1" COLOR="#176D72" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#176D72"><FONT COLOR="white"><B>visit_procedures</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">visit_id</TD><TD PORT="visit_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">procedure_id</TD><TD PORT="procedure_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">name_snapshot</TD><TD PORT="name_snapshot" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">unit_price</TD><TD PORT="unit_price" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">quantity</TD><TD PORT="quantity" ALIGN="LEFT">integer</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ (visit_id, procedure_id)</TD></TR></TABLE>>];
patients [label=<<TABLE BORDER="1" COLOR="#8293A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E5EDF0"><B>patients</B><BR/><FONT POINT-SIZE="9">Referensi</FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id : bigint</TD></TR></TABLE>>];
medical_staff [label=<<TABLE BORDER="1" COLOR="#8293A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E5EDF0"><B>medical_staff</B><BR/><FONT POINT-SIZE="9">Referensi</FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id : bigint</TD></TR></TABLE>>];
clinics [label=<<TABLE BORDER="1" COLOR="#8293A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E5EDF0"><B>clinics</B><BR/><FONT POINT-SIZE="9">Referensi</FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id : bigint</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" COLOR="#8293A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E5EDF0"><B>users</B><BR/><FONT POINT-SIZE="9">Referensi</FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id : bigint</TD></TR></TABLE>>];
doctor_schedules [label=<<TABLE BORDER="1" COLOR="#8293A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E5EDF0"><B>doctor_schedules</B><BR/><FONT POINT-SIZE="9">Referensi</FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id : bigint</TD></TR><TR><TD PORT="doctor_id" ALIGN="LEFT">doctor_id : bigint</TD></TR><TR><TD PORT="clinic_id" ALIGN="LEFT">clinic_id : bigint</TD></TR></TABLE>>];
procedures [label=<<TABLE BORDER="1" COLOR="#8293A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E5EDF0"><B>procedures</B><BR/><FONT POINT-SIZE="9">Referensi</FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id : bigint</TD></TR></TABLE>>];
visits:patient_id:e -> patients:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
visits:doctor_id:e -> medical_staff:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
visits:clinic_id:e -> clinics:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
visits:registered_by:e -> users:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
visits:schedule_id:e -> doctor_schedules:id:e [taillabel="0..N", headlabel="1", label="schedule_id / doctor_id / clinic_id", labeldistance=1.5];
medical_records:visit_id:e -> visits:id:e [taillabel="0..1", headlabel="1", label="", labeldistance=1.5];
medical_records:updated_by:e -> users:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
visit_procedures:visit_id:e -> visits:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
visit_procedures:procedure_id:e -> procedures:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
}
