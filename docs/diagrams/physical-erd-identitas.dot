digraph physical_erd {
graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=1.2, splines=spline, fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Physical ERD - Identitas dan akses\nTabel referensi luar kelompok ditampilkan ringkas | PK: primary key | FK: foreign key | UQ: unik | NN: wajib diisi\nAngka pada garis menunjukkan kardinalitas; buka SVG untuk memperbesar."];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [color="#8393A0", fontcolor="#42566A", fontname="DejaVu Sans", fontsize=9, arrowsize=0.6, dir=both, arrowhead=none, arrowtail=none];
medical_staff [label=<<TABLE BORDER="1" COLOR="#3D637D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#3D637D"><FONT COLOR="white"><B>medical_staff</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ NN</TD><TD ALIGN="LEFT">code</TD><TD PORT="code" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">name</TD><TD PORT="name" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">profession</TD><TD PORT="profession" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">active</TD><TD PORT="active" ALIGN="LEFT">boolean</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" COLOR="#3D637D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#3D637D"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ NN</TD><TD ALIGN="LEFT">username</TD><TD PORT="username" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">password_hash</TD><TD PORT="password_hash" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">name</TD><TD PORT="name" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">role</TD><TD PORT="role" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK UQ</TD><TD ALIGN="LEFT">staff_id</TD><TD PORT="staff_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">active</TD><TD PORT="active" ALIGN="LEFT">boolean</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">token_version</TD><TD PORT="token_version" ALIGN="LEFT">integer</TD></TR></TABLE>>];
patients [label=<<TABLE BORDER="1" COLOR="#3D637D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#3D637D"><FONT COLOR="white"><B>patients</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ NN</TD><TD ALIGN="LEFT">medical_record_no</TD><TD PORT="medical_record_no" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ</TD><TD ALIGN="LEFT">identity_no</TD><TD PORT="identity_no" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">name</TD><TD PORT="name" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">birth_date</TD><TD PORT="birth_date" ALIGN="LEFT">date</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">sex</TD><TD PORT="sex" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">-</TD><TD ALIGN="LEFT">phone</TD><TD PORT="phone" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">-</TD><TD ALIGN="LEFT">address</TD><TD PORT="address" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">active</TD><TD PORT="active" ALIGN="LEFT">boolean</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz</TD></TR></TABLE>>];
login_attempts [label=<<TABLE BORDER="1" COLOR="#3D637D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#3D637D"><FONT COLOR="white"><B>login_attempts</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">bucket</TD><TD PORT="bucket" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">window_start</TD><TD PORT="window_start" ALIGN="LEFT">timestamptz</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">attempts</TD><TD PORT="attempts" ALIGN="LEFT">integer</TD></TR></TABLE>>];
audit_logs [label=<<TABLE BORDER="1" COLOR="#3D637D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#3D637D"><FONT COLOR="white"><B>audit_logs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">actor_id</TD><TD PORT="actor_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">action</TD><TD PORT="action" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">entity_type</TD><TD PORT="entity_type" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">entity_id</TD><TD PORT="entity_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">-</TD><TD ALIGN="LEFT">before_data</TD><TD PORT="before_data" ALIGN="LEFT">jsonb</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">-</TD><TD ALIGN="LEFT">after_data</TD><TD PORT="after_data" ALIGN="LEFT">jsonb</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">-</TD><TD ALIGN="LEFT">reason</TD><TD PORT="reason" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">-</TD><TD ALIGN="LEFT">request_id</TD><TD PORT="request_id" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz</TD></TR></TABLE>>];
users:staff_id:e -> medical_staff:id:e [taillabel="0..1", headlabel="0..1", label="", labeldistance=1.5];
audit_logs:actor_id:e -> users:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
}
