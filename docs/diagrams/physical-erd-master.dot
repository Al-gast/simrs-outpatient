digraph physical_erd {
graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=1.2, splines=spline, fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Physical ERD - Master dan antrean\nTabel referensi luar kelompok ditampilkan ringkas | PK: primary key | FK: foreign key | UQ: unik | NN: wajib diisi\nAngka pada garis menunjukkan kardinalitas; buka SVG untuk memperbesar."];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [color="#8393A0", fontcolor="#42566A", fontname="DejaVu Sans", fontsize=9, arrowsize=0.6, dir=both, arrowhead=none, arrowtail=none];
clinics [label=<<TABLE BORDER="1" COLOR="#56734C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#56734C"><FONT COLOR="white"><B>clinics</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ NN</TD><TD ALIGN="LEFT">code</TD><TD PORT="code" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">name</TD><TD PORT="name" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">registration_fee</TD><TD PORT="registration_fee" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">active</TD><TD PORT="active" ALIGN="LEFT">boolean</TD></TR></TABLE>>];
doctor_schedules [label=<<TABLE BORDER="1" COLOR="#56734C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#56734C"><FONT COLOR="white"><B>doctor_schedules</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">doctor_id</TD><TD PORT="doctor_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">clinic_id</TD><TD PORT="clinic_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">weekday</TD><TD PORT="weekday" ALIGN="LEFT">smallint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">start_time</TD><TD PORT="start_time" ALIGN="LEFT">time</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">end_time</TD><TD PORT="end_time" ALIGN="LEFT">time</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">active</TD><TD PORT="active" ALIGN="LEFT">boolean</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ (doctor_id, clinic_id, weekday, start_time)</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ (id, doctor_id, clinic_id)</TD></TR></TABLE>>];
queue_counters [label=<<TABLE BORDER="1" COLOR="#56734C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#56734C"><FONT COLOR="white"><B>queue_counters</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK FK NN</TD><TD ALIGN="LEFT">clinic_id</TD><TD PORT="clinic_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">visit_date</TD><TD PORT="visit_date" ALIGN="LEFT">date</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">last_number</TD><TD PORT="last_number" ALIGN="LEFT">integer</TD></TR></TABLE>>];
procedures [label=<<TABLE BORDER="1" COLOR="#56734C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#56734C"><FONT COLOR="white"><B>procedures</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ NN</TD><TD ALIGN="LEFT">code</TD><TD PORT="code" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">name</TD><TD PORT="name" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">price</TD><TD PORT="price" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">active</TD><TD PORT="active" ALIGN="LEFT">boolean</TD></TR></TABLE>>];
medicines [label=<<TABLE BORDER="1" COLOR="#56734C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#56734C"><FONT COLOR="white"><B>medicines</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ NN</TD><TD ALIGN="LEFT">code</TD><TD PORT="code" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">name</TD><TD PORT="name" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">unit</TD><TD PORT="unit" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">stock</TD><TD PORT="stock" ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">price</TD><TD PORT="price" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">active</TD><TD PORT="active" ALIGN="LEFT">boolean</TD></TR></TABLE>>];
lab_tests [label=<<TABLE BORDER="1" COLOR="#56734C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#56734C"><FONT COLOR="white"><B>lab_tests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ NN</TD><TD ALIGN="LEFT">code</TD><TD PORT="code" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">name</TD><TD PORT="name" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">-</TD><TD ALIGN="LEFT">unit</TD><TD PORT="unit" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">price</TD><TD PORT="price" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">active</TD><TD PORT="active" ALIGN="LEFT">boolean</TD></TR></TABLE>>];
medical_staff [label=<<TABLE BORDER="1" COLOR="#8293A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E5EDF0"><B>medical_staff</B><BR/><FONT POINT-SIZE="9">Referensi</FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id : bigint</TD></TR></TABLE>>];
doctor_schedules:doctor_id:e -> medical_staff:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
doctor_schedules:clinic_id:e -> clinics:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
queue_counters:clinic_id:e -> clinics:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
}
