digraph physical_erd {
graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=1.2, splines=spline, fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Physical ERD - Farmasi\nTabel referensi luar kelompok ditampilkan ringkas | PK: primary key | FK: foreign key | UQ: unik | NN: wajib diisi\nAngka pada garis menunjukkan kardinalitas; buka SVG untuk memperbesar."];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [color="#8393A0", fontcolor="#42566A", fontname="DejaVu Sans", fontsize=9, arrowsize=0.6, dir=both, arrowhead=none, arrowtail=none];
prescriptions [label=<<TABLE BORDER="1" COLOR="#866A37" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#866A37"><FONT COLOR="white"><B>prescriptions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK UQ NN</TD><TD ALIGN="LEFT">visit_id</TD><TD PORT="visit_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">status</TD><TD PORT="status" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">created_by</TD><TD PORT="created_by" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK</TD><TD ALIGN="LEFT">dispensed_by</TD><TD PORT="dispensed_by" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">-</TD><TD ALIGN="LEFT">dispensed_at</TD><TD PORT="dispensed_at" ALIGN="LEFT">timestamptz</TD></TR></TABLE>>];
prescription_items [label=<<TABLE BORDER="1" COLOR="#866A37" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#866A37"><FONT COLOR="white"><B>prescription_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">prescription_id</TD><TD PORT="prescription_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">medicine_id</TD><TD PORT="medicine_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">name_snapshot</TD><TD PORT="name_snapshot" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">dosage</TD><TD PORT="dosage" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">frequency</TD><TD PORT="frequency" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">quantity</TD><TD PORT="quantity" ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">unit_price</TD><TD PORT="unit_price" ALIGN="LEFT">bigint</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ (prescription_id, medicine_id)</TD></TR></TABLE>>];
stock_movements [label=<<TABLE BORDER="1" COLOR="#866A37" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#866A37"><FONT COLOR="white"><B>stock_movements</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">medicine_id</TD><TD PORT="medicine_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK UQ</TD><TD ALIGN="LEFT">prescription_item_id</TD><TD PORT="prescription_item_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">kind</TD><TD PORT="kind" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">quantity_delta</TD><TD PORT="quantity_delta" ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">balance_after</TD><TD PORT="balance_after" ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">reason</TD><TD PORT="reason" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">actor_id</TD><TD PORT="actor_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz</TD></TR></TABLE>>];
stock_adjustment_requests [label=<<TABLE BORDER="1" COLOR="#866A37" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#866A37"><FONT COLOR="white"><B>stock_adjustment_requests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">event_key</TD><TD PORT="event_key" ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">medicine_id</TD><TD PORT="medicine_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">actor_id</TD><TD PORT="actor_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">payload_hash</TD><TD PORT="payload_hash" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK UQ NN</TD><TD ALIGN="LEFT">movement_id</TD><TD PORT="movement_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz</TD></TR></TABLE>>];
visits [label=<<TABLE BORDER="1" COLOR="#8293A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E5EDF0"><B>visits</B><BR/><FONT POINT-SIZE="9">Referensi</FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id : bigint</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" COLOR="#8293A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E5EDF0"><B>users</B><BR/><FONT POINT-SIZE="9">Referensi</FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id : bigint</TD></TR></TABLE>>];
medicines [label=<<TABLE BORDER="1" COLOR="#8293A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E5EDF0"><B>medicines</B><BR/><FONT POINT-SIZE="9">Referensi</FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id : bigint</TD></TR></TABLE>>];
prescriptions:visit_id:e -> visits:id:e [taillabel="0..1", headlabel="1", label="", labeldistance=1.5];
prescriptions:created_by:e -> users:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
prescriptions:dispensed_by:e -> users:id:e [taillabel="0..N", headlabel="0..1", label="", labeldistance=1.5];
prescription_items:prescription_id:e -> prescriptions:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
prescription_items:medicine_id:e -> medicines:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
stock_movements:medicine_id:e -> medicines:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
stock_movements:prescription_item_id:e -> prescription_items:id:e [taillabel="0..1", headlabel="0..1", label="", labeldistance=1.5];
stock_movements:actor_id:e -> users:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
stock_adjustment_requests:medicine_id:e -> medicines:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
stock_adjustment_requests:actor_id:e -> users:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
stock_adjustment_requests:movement_id:e -> stock_movements:id:e [taillabel="0..1", headlabel="1", label="", labeldistance=1.5];
}
