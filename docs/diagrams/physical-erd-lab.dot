digraph physical_erd {
graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=1.2, splines=spline, fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Physical ERD - Laboratorium\nTabel referensi luar kelompok ditampilkan ringkas | PK: primary key | FK: foreign key | UQ: unik | NN: wajib diisi\nAngka pada garis menunjukkan kardinalitas; buka SVG untuk memperbesar."];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [color="#8393A0", fontcolor="#42566A", fontname="DejaVu Sans", fontsize=9, arrowsize=0.6, dir=both, arrowhead=none, arrowtail=none];
lab_orders [label=<<TABLE BORDER="1" COLOR="#72598B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#72598B"><FONT COLOR="white"><B>lab_orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">visit_id</TD><TD PORT="visit_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">status</TD><TD PORT="status" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">created_by</TD><TD PORT="created_by" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz</TD></TR></TABLE>>];
lab_order_items [label=<<TABLE BORDER="1" COLOR="#72598B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#72598B"><FONT COLOR="white"><B>lab_order_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">lab_order_id</TD><TD PORT="lab_order_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">lab_test_id</TD><TD PORT="lab_test_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">name_snapshot</TD><TD PORT="name_snapshot" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">unit_price</TD><TD PORT="unit_price" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">-</TD><TD ALIGN="LEFT">result_text</TD><TD PORT="result_text" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK</TD><TD ALIGN="LEFT">resulted_by</TD><TD PORT="resulted_by" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">-</TD><TD ALIGN="LEFT">resulted_at</TD><TD PORT="resulted_at" ALIGN="LEFT">timestamptz</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ (lab_order_id, lab_test_id)</TD></TR></TABLE>>];
lab_result_events [label=<<TABLE BORDER="1" COLOR="#72598B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#72598B"><FONT COLOR="white"><B>lab_result_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ NN</TD><TD ALIGN="LEFT">event_key</TD><TD PORT="event_key" ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">lab_order_item_id</TD><TD PORT="lab_order_item_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">payload_hash</TD><TD PORT="payload_hash" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">actor_id</TD><TD PORT="actor_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz</TD></TR></TABLE>>];
visits [label=<<TABLE BORDER="1" COLOR="#8293A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E5EDF0"><B>visits</B><BR/><FONT POINT-SIZE="9">Referensi</FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id : bigint</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" COLOR="#8293A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E5EDF0"><B>users</B><BR/><FONT POINT-SIZE="9">Referensi</FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id : bigint</TD></TR></TABLE>>];
lab_tests [label=<<TABLE BORDER="1" COLOR="#8293A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E5EDF0"><B>lab_tests</B><BR/><FONT POINT-SIZE="9">Referensi</FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id : bigint</TD></TR></TABLE>>];
lab_orders:visit_id:e -> visits:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
lab_orders:created_by:e -> users:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
lab_order_items:lab_order_id:e -> lab_orders:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
lab_order_items:lab_test_id:e -> lab_tests:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
lab_order_items:resulted_by:e -> users:id:e [taillabel="0..N", headlabel="0..1", label="", labeldistance=1.5];
lab_result_events:lab_order_item_id:e -> lab_order_items:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
lab_result_events:actor_id:e -> users:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
}
