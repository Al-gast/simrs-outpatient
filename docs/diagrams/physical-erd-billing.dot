digraph physical_erd {
graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=1.2, splines=spline, fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Physical ERD - Tagihan dan pembayaran\nTabel referensi luar kelompok ditampilkan ringkas | PK: primary key | FK: foreign key | UQ: unik | NN: wajib diisi\nAngka pada garis menunjukkan kardinalitas; buka SVG untuk memperbesar."];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [color="#8393A0", fontcolor="#42566A", fontname="DejaVu Sans", fontsize=9, arrowsize=0.6, dir=both, arrowhead=none, arrowtail=none];
invoices [label=<<TABLE BORDER="1" COLOR="#A05B4D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#A05B4D"><FONT COLOR="white"><B>invoices</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK UQ NN</TD><TD ALIGN="LEFT">visit_id</TD><TD PORT="visit_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ NN</TD><TD ALIGN="LEFT">invoice_no</TD><TD PORT="invoice_no" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">total_amount</TD><TD PORT="total_amount" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">revision</TD><TD PORT="revision" ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">created_by</TD><TD PORT="created_by" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">updated_at</TD><TD PORT="updated_at" ALIGN="LEFT">timestamptz</TD></TR></TABLE>>];
invoice_items [label=<<TABLE BORDER="1" COLOR="#A05B4D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#A05B4D"><FONT COLOR="white"><B>invoice_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">invoice_id</TD><TD PORT="invoice_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">category</TD><TD PORT="category" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">source_id</TD><TD PORT="source_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">description</TD><TD PORT="description" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">unit_price</TD><TD PORT="unit_price" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">quantity</TD><TD PORT="quantity" ALIGN="LEFT">integer</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ (invoice_id, category, source_id)</TD></TR></TABLE>>];
payments [label=<<TABLE BORDER="1" COLOR="#A05B4D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#A05B4D"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">invoice_id</TD><TD PORT="invoice_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ NN</TD><TD ALIGN="LEFT">receipt_no</TD><TD PORT="receipt_no" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ NN</TD><TD ALIGN="LEFT">idempotency_key</TD><TD PORT="idempotency_key" ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">payload_hash</TD><TD PORT="payload_hash" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">amount</TD><TD PORT="amount" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">method</TD><TD PORT="method" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">FK NN</TD><TD ALIGN="LEFT">cashier_id</TD><TD PORT="cashier_id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">paid_at</TD><TD PORT="paid_at" ALIGN="LEFT">timestamptz</TD></TR></TABLE>>];
visits [label=<<TABLE BORDER="1" COLOR="#8293A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E5EDF0"><B>visits</B><BR/><FONT POINT-SIZE="9">Referensi</FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id : bigint</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" COLOR="#8293A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E5EDF0"><B>users</B><BR/><FONT POINT-SIZE="9">Referensi</FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id : bigint</TD></TR></TABLE>>];
invoices:visit_id:e -> visits:id:e [taillabel="0..1", headlabel="1", label="", labeldistance=1.5];
invoices:created_by:e -> users:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
invoice_items:invoice_id:e -> invoices:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
payments:invoice_id:e -> invoices:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
payments:cashier_id:e -> users:id:e [taillabel="0..N", headlabel="1", label="", labeldistance=1.5];
}
