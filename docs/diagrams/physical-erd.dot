lab_tests [label=<<TABLE BORDER="1" COLOR="#56734C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#56734C"><FONT COLOR="white"><B>lab_tests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">PK NN</TD><TD ALIGN="LEFT">id</TD><TD PORT="id" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">UQ NN</TD><TD ALIGN="LEFT">code</TD><TD PORT="code" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">name</TD><TD PORT="name" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">-</TD><TD ALIGN="LEFT">unit</TD><TD PORT="unit" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">price</TD><TD PORT="price" ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F4F7">NN</TD><TD ALIGN="LEFT">active</TD><TD PORT="active" ALIGN="LEFT">boolean</TD></TR></TABLE>>];
}
