{
  "info": {
    "name": "SIMRS Phase 8 Reporting & Admin",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set report_from/report_to to desired WIB dates. Read-only and negative probes; write lifecycle tested by report-admin-smoke.py (not executed yet)."
  },
  "variable": [
    {
      "key": "report_from",
      "value": "2026-11-01"
    },
    {
      "key": "report_to",
      "value": "2026-11-24"
    },
    {
      "key": "report_admin_token",
      "value": ""
    },
    {
      "key": "report_registration_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login admin",
      "request": {
        "method": "POST",
        "url": "{{core_url}}/auth/login",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin\", \"password\": \"{{demo_prefix}}-admin\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if(pm.response.code===200) pm.collectionVariables.set(\"report_admin_token\",pm.response.json().data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login registration",
      "request": {
        "method": "POST",
        "url": "{{core_url}}/auth/login",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"registration\", \"password\": \"{{demo_prefix}}-registration\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if(pm.response.code===200) pm.collectionVariables.set(\"report_registration_token\",pm.response.json().data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Dashboard summary",
      "request": {
        "method": "GET",
        "url": "{{node_url}}/reports/summary?from={{report_from}}&to={{report_to}}",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{report_admin_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
