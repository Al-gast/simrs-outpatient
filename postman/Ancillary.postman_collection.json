{
  "info": {
    "name": "SIMRS Phase 6 Ancillary",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Read and validation probes. Write, race and retry scenarios in scripts/ancillary-smoke.py."
  },
  "variable": [
    {
      "key": "anc_pharmacy_token",
      "value": ""
    },
    {
      "key": "anc_laboratory_token",
      "value": ""
    },
    {
      "key": "anc_doctor_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login pharmacy",
      "request": {
        "method": "POST",
        "url": "{{core_url}}/auth/login",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"pharmacy\", \"password\": \"{{demo_prefix}}-pharmacy\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"anc_pharmacy_token\", pm.response.json().data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login laboratory",
      "request": {
        "method": "POST",
        "url": "{{core_url}}/auth/login",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"laboratory\", \"password\": \"{{demo_prefix}}-laboratory\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"anc_laboratory_token\", pm.response.json().data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login doctor",
      "request": {
        "method": "POST",
        "url": "{{core_url}}/auth/login",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"doctor\", \"password\": \"{{demo_prefix}}-doctor\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"anc_doctor_token\", pm.response.json().data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Pharmacy pending list",
      "request": {
        "method": "GET",
        "url": "{{core_url}}/pharmacy/orders?status=pending",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{anc_pharmacy_token}}"
          }
        ],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Laboratory list",
      "request": {
        "method": "GET",
        "url": "{{core_url}}/laboratory/orders?status=all",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{anc_laboratory_token}}"
          }
        ],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Doctor denied pharmacy list",
      "request": {
        "method": "GET",
        "url": "{{core_url}}/pharmacy/orders",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{anc_doctor_token}}"
          }
        ],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Pharmacy denied Node result",
      "request": {
        "method": "POST",
        "url": "{{node_url}}/laboratory/items/1/result",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{anc_pharmacy_token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "12345678-1234-1234-1234-123456789abc"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"result_text\": \"Dummy\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Node rejects missing idempotency key",
      "request": {
        "method": "POST",
        "url": "{{node_url}}/laboratory/items/1/result",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{anc_laboratory_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"result_text\": \"Dummy\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "Node rejects unknown writable field",
      "request": {
        "method": "POST",
        "url": "{{node_url}}/laboratory/items/1/result",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{anc_laboratory_token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "12345678-1234-1234-1234-123456789abc"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"result_text\": \"Dummy\", \"actor_id\": \"1\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    }
  ]
}
