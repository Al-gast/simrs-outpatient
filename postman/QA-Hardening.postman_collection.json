{
  "info": {
    "name": "SIMRS Phase 9 \u2014 Stock Retry QA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Disposable dummy DB only; creates medicine and stock movement, run in order with SIMRS environment. Prepared, not executed."
  },
  "item": [
    {
      "name": "Admin login and generate dummy identifiers",
      "request": {
        "method": "POST",
        "url": "{{core_url}}/auth/login",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin\", \"password\": \"{{demo_prefix}}-admin\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"qa_code\",\"QA-\"+pm.variables.replaceIn(\"{{$randomUUID}}\"));",
              "pm.collectionVariables.set(\"qa_key\",pm.variables.replaceIn(\"{{$randomUUID}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code===200) pm.collectionVariables.set(\"qa_token\",pm.response.json().data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create disposable medicine",
      "request": {
        "method": "POST",
        "url": "{{core_url}}/master/medicines",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{qa_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"code\": \"{{qa_code}}\", \"name\": \"QA stock dummy\", \"price\": \"500\", \"unit\": \"tablet\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.collectionVariables.set(\"qa_medicine\",pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "First adjustment",
      "request": {
        "method": "POST",
        "url": "{{core_url}}/master/medicines/{{qa_medicine}}/adjust-stock",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{qa_key}}"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{qa_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"delta\": 5, \"reason\": \"Postman dummy QA\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const d=pm.response.json().data; pm.test(\"Stock 5 and original write\",()=>{pm.expect(d.stock).to.eql(5);pm.expect(d.replayed).to.eql(false);});",
              "pm.collectionVariables.set(\"qa_movement\",d.movement_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Same-key retry",
      "request": {
        "method": "POST",
        "url": "{{core_url}}/master/medicines/{{qa_medicine}}/adjust-stock",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{qa_key}}"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{qa_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"delta\": 5, \"reason\": \"Postman dummy QA\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const d=pm.response.json().data; pm.test(\"Same movement, no extra stock\",()=>{pm.expect(d.stock).to.eql(5);pm.expect(d.replayed).to.eql(true);pm.expect(d.movement_id).to.eql(pm.collectionVariables.get(\"qa_movement\"));});"
            ]
          }
        }
      ]
    },
    {
      "name": "Changed payload conflict",
      "request": {
        "method": "POST",
        "url": "{{core_url}}/master/medicines/{{qa_medicine}}/adjust-stock",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{qa_key}}"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{qa_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"delta\": 6, \"reason\": \"Postman dummy QA\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Idempotency conflict\",()=>pm.expect(pm.response.json().error.code).to.eql(\"IDEMPOTENCY_CONFLICT\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing key rejected",
      "request": {
        "method": "POST",
        "url": "{{core_url}}/master/medicines/{{qa_medicine}}/adjust-stock",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{qa_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"delta\": 5, \"reason\": \"Postman dummy QA\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirm stock unchanged",
      "request": {
        "method": "GET",
        "url": "{{core_url}}/master/medicines/{{qa_medicine}}",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{qa_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Stock remains 5\",()=>pm.expect(pm.response.json().data.stock).to.eql(5));"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": "{{core_url}}/auth/logout",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{qa_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.collectionVariables.unset(\"qa_token\");"
            ]
          }
        }
      ]
    }
  ]
}
